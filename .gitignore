.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------------------------------------
# Data (raw, processed, interim — keep structure via .gitkeep if needed)
# -----------------------------------------------------------------------------
data/
datasets/
dataset/
raw/
processed/
interim/
external/
downloads/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.hdf5
*.h5
*.hdf
*.nc
*.npy
*.npz
*.mat
*.pkl
*.pickle
*.joblib
*.jsonl
*.sqlite
*.db

# Allow small sample / fixture data when explicitly needed
!data/samples/**
!tests/fixtures/**
!**/fixtures/**/*.csv
!**/fixtures/**/*.json
!**/fixtures/**/*.npy

