!.vscode/settings.json.example
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.cursor/

# -----------------------------------------------------------------------------
