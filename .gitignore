__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec
.Python
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
.virtualenv/

# Package / dependency managers
.pdm-python
.pdm.toml
.pdm-build/
__pypackages__/
.python-version
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
cython_debug/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
